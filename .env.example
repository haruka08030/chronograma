# Google Calendar (optional)
VITE_GOOGLE_CLIENT_ID=

# Supabase — cloud sync & login (https://supabase.com)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (optional) — morning/evening reminders delivered even when the app is closed.
# Generate a VAPID key pair with `npx web-push generate-vapid-keys`; the private key goes to the
# Edge Function secrets (see README), only the public key goes here.
VITE_VAPID_PUBLIC_KEY=
